# Book Marketing Studio — environment
# Generate each secret with: openssl rand -hex 32

# Encrypts saved API keys (AES-256-GCM). Keep a copy in your password
# manager — losing it makes every saved key undecryptable.
ENCRYPTION_KEY=

# Signs CSRF tokens.
SESSION_SECRET=

# Main admin, created on first start when there are no accounts yet.
# Sign in with this username; change the password after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Shared secret for incoming book handoffs (POST /api/handoff).
# Can also be set in the app under Settings → Integrations.
HANDOFF_TOKEN=

# Public address for smart links, book pages and emails
# (can also be set in Settings → Integrations).
PUBLIC_BASE_URL=https://bookmarketing.amaldas.si

PORT=3001
HOST=127.0.0.1
DB_PATH=./data/marketing-studio.db
